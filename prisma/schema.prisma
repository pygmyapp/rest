generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  compilerBuild = "fast"
  runtime       = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id
  email    String    @unique
  username String    @unique
  hash     String
  verified Boolean   @default(false)
  sessions Session[]

  // Email Verification
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?
  emailVerificationCreatedAt DateTime?

  // Profile
  profile Profile?

  // Friends
  friends  User[] @relation("UserFriends")
  friendOf User[] @relation("UserFriends")

  sentRequests     Request[] @relation("SentRequests")
  receivedRequests Request[] @relation("ReceivedRequests")
}

model Profile {
  id     Int    @id @default(autoincrement())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  avatar      Boolean @default(false)
  displayName String?
  bio         String?
  pronouns    String?
}

model Request {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  type      RequestType

  fromUser   User   @relation("SentRequests", fields: [fromUserId], references: [id])
  fromUserId String

  toUser   User   @relation("ReceivedRequests", fields: [toUserId], references: [id])
  toUserId String

  // Prevent duplicates
  @@unique([fromUserId, toUserId])
}

model Session {
  id      String   @id
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  lastUse DateTime @default(now())
}

enum RequestType {
  FRIEND_REQUEST
}
