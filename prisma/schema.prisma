generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  compilerBuild = "fast"
  runtime       = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id
  email    String    @unique
  username String    @unique
  hash     String
  verified Boolean   @default(false)
  sessions Session[]

  // Profile
  profile Profile?

  // Email Verification
  emailVerificationToken EmailVerificationToken?

  // Friends
  friends  User[] @relation("UserFriends")
  friendOf User[] @relation("UserFriends")

  sentRequests     Request[] @relation("SentRequests")
  receivedRequests Request[] @relation("ReceivedRequests")

  // Blocked Users
  blocked UserBlock[] @relation("user")
  blockedBy UserBlock[] @relation("blockedUser")
}

model Profile {
  id     Int    @id @default(autoincrement())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  avatar      Boolean @default(false)
  displayName String?
  bio         String?
  pronouns    String?
}

model Request {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  type      RequestType

  fromUser   User   @relation("SentRequests", fields: [fromUserId], references: [id])
  fromUserId String

  toUser   User   @relation("ReceivedRequests", fields: [toUserId], references: [id])
  toUserId String

  // Prevent duplicates
  @@unique([fromUserId, toUserId])
}

model UserBlock {
  userId String
  blockedUserId String
  createdAt DateTime    @default(now())

  user User @relation("user", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser User @relation("blockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([userId, blockedUserId])
  @@index([blockedUserId])
}

model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  userAgent String?
  ipAddress String?
  lastUse   DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid(2))
  hash      String   @unique
  createdAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
}

enum RequestType {
  FRIEND_REQUEST
}
